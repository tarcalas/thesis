{
    "name": "thesis",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/workspaces/thesis",
    "features": {},
    "mounts": [
        "source=${env:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
        "source=${env:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
    ],
    "remoteEnv": {
        "SSH_AUTH_SOCK": "/ssh-agent"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": ".venv/bin/python",
                "python.terminal.activateEnvironment": true
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "tamasfe.even-better-toml",
                "redhat.vscode-yaml"
            ]
        }
    },
    "shutdownAction": "none",
    "overrideCommand": false,
    "postCreateCommand": "bash -lc \"uv python install && uv venv && uv pip install -e .\"",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true
}