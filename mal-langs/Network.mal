#id: "tno-netLang"
#version: "1.0.0"

category Component{
    asset Device {
        | physicalAccess @entrypoint

        | attemptNetworkCommunication
    }

    asset AuthenticatedAccessChannel {
        | attemptAuthenticatedCommunication @entrypoint
            -> attemptCommunication

        | attemptCommunication
            -> inDataChannel.connectToDataChannel
    }

    asset DataChannel {
        | connectToDataChannel @entrypoint
            -> outgoingAuthenticationRule.attemptAuthenticatedCommunication,
            connectToDevice
        
        E isInDataChannel
            <- incomingAuthenticationRule
            -> connectToDevice
        
        & connectToDevice
            -> device.attemptNetworkCommunication
    }

    asset Privilege {

    }

    asset Identity {
    }

}

associations {
    Device [senderDevice]         *<-- DeviceOutgoingCommunication -->*          [outgoingAuthenticationRule] AuthenticatedAccessChannel
    Device [receiverDevice]       *<-- DeviceIncomingCommunication -->*          [incomingAuthenticationRule] AuthenticatedAccessChannel
    Identity [identity]                   *<-- IdentityHasPrivileges -->*                                         [privileges] Privilege
    AuthenticatedAccessChannel [authenticationRule]     *<-- AuthenticatedAccessChannelRequiresPrivilege -->*      [privilege] Privilege
    Identity [leftIdentity]                        0..1<-- IdentitiesEquivalent -->*                          [rightIdentities] Identity
    Device [controllerDevice]    0..1<-- DeviceControlsAuthentication -->*    [controlledAuthenticationRules] AuthenticatedAccessChannel
    DataChannel [outDataChannel] *<-- DataChannelOutgoingCommunication -->*      [outgoingAuthenticationRule] AuthenticatedAccessChannel
    DataChannel [inDataChannel]   *<-- DataChannelIncomingCommunication -->*     [incomingAuthenticationRule] AuthenticatedAccessChannel
    Device [device]                   1<--DeviceHasDataChannels-->*                                           [DataChannels] DataChannel
}